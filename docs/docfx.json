{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": ["src/ModernLrc/ModernLrc.csproj"]
        }
      ],
      "dest": "api",
      "outputFormat": "mref",
      "memberLayout": "samePage",
      "namespaceLayout": "nested",
      "enumSortOrder": "declaringOrder",
      "allowCompilationErrors": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appName": "ModernLrc",
      "_appTitle": "ModernLrc",
      "_appFooter": "© ModernLrc contributors. Built with <a href='https://dotnet.github.io/docfx'>DocFX</a>.",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/Anthonyy232/ModernLrcParser",
        "branch": "main"
      }
    },
    "template": ["default", "modern"],
    "postProcessors": ["ExtractSearchIndex"],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
