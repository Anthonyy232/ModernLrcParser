{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": ["src/ModernLrc/ModernLrc.csproj"]
        }
      ],
      "dest": "api",
      "outputFormat": "mref",
      "memberLayout": "samePage",
      "namespaceLayout": "nested",
      "enumSortOrder": "declaringOrder",
      "allowCompilationErrors": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml"]
      },
      {
        "files": ["articles/**.md", "articles/**/toc.yml", "toc.yml"]
      }
    ],
    "resource": [
      {
        "src": "../site",
        "files": ["**"]
      },
      {
        "src": "../assets",
        "files": ["logo.svg"]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appName": "ModernLrc",
      "_appTitle": "ModernLrc",
      "_appLogoPath": "logo.svg",
      "_appFaviconPath": "logo.svg",
      "_appFooter": "Copyright © 2026 Anthony La. Free software under the <a href='https://github.com/Anthonyy232/ModernLrcParser/blob/main/LICENSE'>GNU GPL v3.0</a>.",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/Anthonyy232/ModernLrcParser",
        "branch": "main"
      }
    },
    "template": ["default", "modern", "template"],
    "postProcessors": ["ExtractSearchIndex"],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
