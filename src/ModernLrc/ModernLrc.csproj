<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ModernLrc</RootNamespace>
    <AssemblyName>ModernLrc</AssemblyName>

    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>ModernLrc</PackageId>
    <Version>3.0.0</Version>
    <Authors>Anthony La</Authors>
    <Copyright>Copyright © 2026 Anthony La</Copyright>
    <Description>A fast LRC lyrics parser and writer for .NET 10, with word timing, duet voices and diagnostics instead of exceptions.</Description>
    <PackageTags>lrc;lyrics;parser;writer;aot;trimming;dotnet</PackageTags>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://anthonyy232.github.io/ModernLrcParser/</PackageProjectUrl>
    <PackageReleaseNotes>See https://github.com/Anthonyy232/ModernLrcParser/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/Anthonyy232/ModernLrcParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- nuget.org renders no HTML, so the package gets its own README without the image panels -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
